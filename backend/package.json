{
  "name": "katana-sushi-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm run prisma:generate && ts-node-dev --respawn --transpile-only --watch src --ignore-watch node_modules --ignore-watch dist --ignore-watch uploads --ignore-watch backups --ignore-watch logs --ignore-watch prisma --ignore-watch \"\\.test\\.ts$\" --debounce 1000 src/server.ts",
    "build": "npm run prisma:generate && tsc",
    "start": "node dist/server.js",
    "start:prod": "node dist/server.js",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:migrate": "npm run prisma:migrate:deploy",
    "db:seed": "prisma db seed --schema=prisma/schema.prisma",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:ready": "npm run prisma:generate && npm run db:migrate && npm run build",
    "prisma:seed": "npm run db:seed",
    "prisma:seed:prod": "prisma db seed --schema=prisma/schema.prisma",
    "inventory:reconcile": "ts-node-dev --transpile-only --exit-child src/scripts/reconcile-inventory.ts",
    "paymongo:webhook": "ts-node-dev --transpile-only --exit-child src/scripts/paymongo-webhook.ts"
  },
  "prisma": {
    "seed": "ts-node-dev --transpile-only --exit-child prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.110.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^6.4.24",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^6.10.1",
    "prisma": "^5.22.0",
    "resend": "^6.25.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
