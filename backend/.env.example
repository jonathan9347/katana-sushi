PORT=5001
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:6543/<DB_NAME>?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="replace-with-a-secure-secret"
JWT_EXPIRES_IN="8h"
SENIOR_PWD_DISCOUNT_RATE=0.20
FRONTEND_URL="http://localhost:5173"
# Payments: "fake" (local testing only, blocked in production) or "paymongo".
PAYMENT_GATEWAY=fake
# PayMongo (Payment Intents on Katana's own payment page). Use test keys until you go live.
PAYMONGO_SECRET_KEY=
# Publishable key (pk_...), shared with the browser for card payments. Must match the secret key's mode.
PAYMONGO_PUBLIC_KEY=
# Secret of the webhook registered for payment.paid (whsk_...).
PAYMONGO_WEBHOOK_SECRET=
# Optional: methods offered on the payment page (default qrph,card,gcash,paymaya).
PAYMONGO_PAYMENT_METHODS=qrph,card,gcash,paymaya
# Optional: minutes before an unpaid payment session is closed (default 60).
PAYMONGO_CHECKOUT_TTL_MINUTES=60

# Email: Gmail SMTP (no domain needed). Create an App Password at
# https://myaccount.google.com/apppasswords (needs 2-Step Verification).
# Port 465 = implicit SSL/TLS, port 587 = STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-16-letter-app-password
EMAIL_FROM=Katana Sushi <yourname@gmail.com>
SEND_EMAILS_IN_DEVELOPMENT=false
# Optional fallback when SMTP_USER/SMTP_PASS are not set
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMS: TextBee (https://textbee.dev) sends through the restaurant's Android phone.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
SEND_SMS_IN_DEVELOPMENT=false
RESTAURANT_ADDRESS=Katana Sushi Restaurant
RESTAURANT_PHONE=Please contact Katana Sushi

# Supabase: storage uploads and staff password codes (Auth).
SUPABASE_URL=https://your-project-ref.supabase.co
# Anon (public) key from Project Settings -> API; emails staff password codes.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=your-bucket-name

# Copy this file to .env for local development and fill values.
NODE_ENV=development
