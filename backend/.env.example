PORT=5001
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:6543/<DB_NAME>?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="replace-with-a-secure-secret"
JWT_EXPIRES_IN="8h"
FRONTEND_URL="http://localhost:5173"
USE_REAL_GATEWAY=false
PAYMENT_GATEWAY=fake

# Email delivery (required when NODE_ENV=production)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@katanasushi.com
SEND_EMAILS_IN_DEVELOPMENT=false
RESTAURANT_ADDRESS=Katana Sushi Restaurant
RESTAURANT_PHONE=Please contact Katana Sushi

# Supabase storage configuration. Set these only when using Supabase uploads.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=your-bucket-name

# Copy this file to .env for local development and fill values.
NODE_ENV=development
